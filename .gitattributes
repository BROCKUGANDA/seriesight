# Normalize all text to LF in the repository, regardless of contributor OS.
# Working-tree line endings are left to each platform's git configuration.
* text=auto eol=lf

# Windows scripts keep CRLF where tooling requires it
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never line-ending rewritten or diffed
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.mp4 binary
*.mp3 binary
*.wav binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary

# Lockfiles must be stable
bun.lock text eol=lf
package-lock.json text eol=lf
pnpm-lock.yaml text eol=lf

# Seriesight environment
# ---------------------------------------------------------------------------
# Copy to `.env` for machine-local overrides. Never commit `.env` — it is
# git-ignored and must stay that way.
#
# The demo/dev workspace requires NO environment variables at all: the SQLite
# database path is embedded in prisma/schema.prisma (prisma/db/seriesight.db).

# ── GRID esports data (optional, server-side only) ─────────────────────────
# Enables real GRID probes/imports through the provider adapter. Without it
# the fixture workspace is fully functional. NEVER expose this to the browser.
# GRID_API_KEY=

# ── Coach authentication ──────────────────────────────────────────────────
# Optional private invitation code; without one, registration is disabled.
# AUTH_INVITE_CODE=
# Required behind a reverse proxy; exact external origin, no trailing slash.
# APP_ORIGIN=https://seriesight.aiazimara.com
# Trust forwarded client IPs ONLY if your proxy overwrites them.
# TRUST_AUTH_PROXY=false

# ── Production database (PostgreSQL) ───────────────────────────────────────
# Required only for production deployments using prisma/schema.production.prisma.
# Local production-parity database: docker compose up -d db
# PROD_DATABASE_URL=postgresql://seriesight:seriesight@localhost:55432/seriesight

# ── Runtime tuning (optional) ──────────────────────────────────────────────
# Disable the in-process integration dispatch loop while global integration
# stores are not workspace-isolated (see instrumentation.ts):
# SERIESIGHT_DISPATCH_INTERVAL_MS=0
# Shared-store API throttles (requests per 60-second window):
# API_RATE_LIMIT_PER_MIN=600
# AUTH_RATE_LIMIT_PER_MIN=60
# LEADS_RATE_LIMIT_PER_MIN=20
